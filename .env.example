# Base URL of the Royale Sky API, including the /api/v1 suffix.
ROYALE_API_BASE_URL=https://api.mpdev.my.id/api/v1

# Upstream request timeout in milliseconds (optional, default 15000).
ROYALE_API_TIMEOUT_MS=15000

# Compatibility for networks whose TLS proxy uses a legacy CA (optional).
# Set to 0 to disable the system-CA fallback entirely.
ROYALE_API_TLS_COMPAT=1

# Temporary PIN-less mode. Requires a server-side service account.
# Leave unset or 0 to keep the normal email/ID + PIN login.
ROYALE_ALLOW_PINLESS_LOGIN=0
ROYALE_SERVICE_USER_ID=
ROYALE_SERVICE_PIN=

# Required in production when PIN-less mode is enabled. Minimum 32 chars.
ROYALE_SESSION_SECRET=
